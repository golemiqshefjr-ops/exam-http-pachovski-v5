@model ExamMvc.Models.Hotel

@{
    ViewBag.Title = "Изтриване";
}

<h2>Изтриване</h2>

<h3>Сигурни ли сте, че искате да изтриете този запис?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.Name)</dt>
        <dd>@Html.DisplayFor(model => model.Name)</dd>

        <dt>@Html.DisplayNameFor(model => model.City)</dt>
        <dd>@Html.DisplayFor(model => model.City)</dd>

        <dt>@Html.DisplayNameFor(model => model.Type)</dt>
        <dd>@Html.DisplayFor(model => model.Type)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HttpMethodOverride(HttpVerbs.Delete)

        <div class="form-actions no-color">
            <input type="submit" value="Изтрий" class="btn btn-danger" /> |
            @Html.ActionLink("Към списъка", "Index")
        </div>
    }
</div>
