@model ExamMvc.Models.Hotel

@{
    ViewBag.Title = Model.Name;
}

<h2>@Model.Name</h2>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.City)</dt>
        <dd>@Html.DisplayFor(model => model.City)</dd>

        <dt>@Html.DisplayNameFor(model => model.Type)</dt>
        <dd>@Html.DisplayFor(model => model.Type)</dd>

        <dt>@Html.DisplayNameFor(model => model.Rooms)</dt>
        <dd>@Html.DisplayFor(model => model.Rooms)</dd>

        <dt>@Html.DisplayNameFor(model => model.PricePerNight)</dt>
        <dd>@Html.DisplayFor(model => model.PricePerNight)</dd>
    </dl>
</div>
<p>
    @Html.ActionLink("Редакция", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Към списъка", "Index")
</p>
